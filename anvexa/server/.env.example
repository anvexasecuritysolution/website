PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/anvexa
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Admin created by `npm run seed`
ADMIN_EMAIL=admin@anvexa.in
ADMIN_PASSWORD=ChangeMe!12345

# Save every lead as JSON in a GitHub repo (optional — leave blank to disable)
# Use a PRIVATE repo: the file contains names and emails.
# Token: GitHub → Settings → Developer settings → Fine-grained tokens → this repo only → Contents: Read and write
GITHUB_TOKEN=
GITHUB_REPO=your-username/anvexa-leads
GITHUB_BRANCH=main
GITHUB_LEADS_PATH=data/leads.json
