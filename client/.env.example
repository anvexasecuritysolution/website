# Leave empty in dev (Vite proxies /api to localhost:5000).
# Set to your API origin if the API is deployed separately, e.g. https://api.anvexa.in
VITE_API_URL=

# ── Vercel (set these in Project → Settings → Environment Variables, NOT in this file) ──
# GITHUB_TOKEN        fine-grained token, only your PRIVATE leads repo, Contents: Read and write
# GITHUB_REPO         your-username/anvexa-leads
# GITHUB_BRANCH       main            (optional)
# GITHUB_LEADS_PATH   data/leads.json (optional)

# ── Serverless lead capture (no backend needed). Set either or both. VITE_ vars are read at BUILD time. ──
# Email each enquiry to you: free access key from https://web3forms.com (enter your email, key arrives by mail)
VITE_WEB3FORMS_KEY=
# Save each enquiry as a Google Sheet row: the Apps Script web-app URL (see ../google-apps-script/Code.gs)
VITE_SHEETS_URL=
